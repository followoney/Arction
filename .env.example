# ═══════════════════════════════════════════════════════════════
#  Arction — Environment Variables
#  Copy this file to ".env.local" and fill in the values.
#  On Vercel, add these in Settings → Environment Variables.
# ═══════════════════════════════════════════════════════════════

# ─── Arc Testnet ───────────────────────────────────────────────
# Verified: docs.arc.network/arc/references/connect-to-arc
NEXT_PUBLIC_ARC_CHAIN_ID=5042002
NEXT_PUBLIC_ARC_RPC_URL=https://rpc.testnet.arc.network
NEXT_PUBLIC_ARC_EXPLORER=https://testnet.arcscan.app

# ─── Contract Addresses (fill after running: npm run deploy:testnet) ──
NEXT_PUBLIC_SIMHASH_CHECKER_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_CELLULAR_VAULT_ADDRESS=0x0000000000000000000000000000000000000000

# ─── Arc Testnet USDC ─────────────────────────────────────────
# Source: docs.arc.network/arc/references/contract-addresses
NEXT_PUBLIC_USDC_ADDRESS=0x3600000000000000000000000000000000000000

# ─── Hardhat Deploy (local development ONLY) ──────────────────
# ⚠ NEVER add this to Vercel or commit to git!
DEPLOYER_PRIVATE_KEY=0x_YOUR_PRIVATE_KEY_HERE
